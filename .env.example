# Скопируй в .env и заполни. .env в .gitignore — не коммитить.
TS_DATA_DIR=data/studio
TS_CHANNEL_FILE=config/studio/channel.yaml
TS_VOICES_FILE=config/studio/voices.yaml

# anthropic | fake
TS_LLM_PROVIDER=anthropic
TS_LLM_MODEL=claude-opus-5-5
# piper | fake
TS_TTS=piper
TS_PIPER_BIN=piper
# faster_whisper | mlx | fake
TS_TRANSCRIBER=faster_whisper
TS_WHISPER_MODEL=large-v3-turbo
# auto | real | fake  (fake — заглушки testsrc для визуалов)
TS_RENDERERS=auto
TS_SANDBOX_IMAGE=techstudio-sandbox:latest
TS_MERMAID_IMAGE=minlag/mermaid-cli:latest
# auto | videotoolbox | x264
TS_ENCODER=auto
# youtube | fake
TS_PUBLISHER=youtube
TS_COLLECTOR=youtube

# Секреты (только env)
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
# Telegram user id через запятую
TS_ADMIN_IDS=
TS_YOUTUBE_CLIENT_SECRETS=data/studio/secrets/youtube_client_secret.json
